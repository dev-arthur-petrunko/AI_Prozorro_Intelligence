# ============================================
# AI Prozorro Intelligence - Змінні середовища
# ============================================

# --- База даних ---
# Локально (за замовчуванням): SQLite
DATABASE_URL=sqlite+aiosqlite:///./prozorro.db
# Продакшн (Neon): вставте connection string з console.neon.tech
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Groq AI API (безкоштовний ключ: console.groq.com) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Ліміти безкоштовного тарифу Groq (30 зап/хв, 1000 зап/день) з запасом
GROQ_MAX_REQUESTS_PER_MINUTE=28
GROQ_MAX_REQUESTS_PER_DAY=950

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHANNEL_ID=-1001234567890

# --- Prozorro API ---
PROZORRO_API_URL=https://public.api.openprocurement.org
PROZORRO_API_VERSION=2.5

# --- Налаштування додатку ---
APP_NAME=AI Prozorro Intelligence
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# --- Налаштування синхронізації ---
INITIAL_IMPORT_DAYS=30
DATA_RETENTION_DAYS=180
SYNC_INTERVAL_MINUTES=10

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI Prozorro Intelligence

# --- n8n (опціонально) ---
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/daily-report
